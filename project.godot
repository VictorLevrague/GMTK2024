; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gmtk 2024"
run/main_scene="res://src/screens/main_screen.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Signals="*res://src/autoload/signals.gd"
Tooltip="*res://src/tooltip/tooltip.tscn"

[display]

window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://assets/mouse.png"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom="res://game_theme.tres"
theme/custom_font="res://assets/fonts/good times rg.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
